# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ===== Bo sung cho UTEExpress (muc 07 buoc 9 trong ke hoach nhom) =====

# Maven build output
target/

# Eclipse
.classpath
.project
.settings/

# IntelliJ IDEA
.idea/
*.iml

# VS Code
.vscode/

# File cau hinh chua mat khau that tren tung may - KHONG bao gio len Git.
# application.properties van len Git binh thuong (chi chua placeholder CHANGE_ME).
application-local.properties

# Cau hinh ket noi database chung tren MonsterASP (co mat khau that).
# Ban mau khong chua mat khau la application-cloud.properties.example, file do
# VAN len Git de ca nhom biet can dien nhung gi.
application-cloud.properties

# Ban sao du lieu xuat ra tu script db/backup-du-lieu.ps1.
# Khong day len Git vi chua du lieu that cua nguoi dung (ho ten, so dien thoai,
# dia chi) va file co the rat nang.
db/backup/

# Tep nguoi dung tai len khi chay thu (anh/video danh gia) - khong day len Git
uploads/

# File khoa tam cua Microsoft Word/Excel (~$ten-file.docx).
# Word tu tao khi mo tai lieu va tu xoa khi dong - khong bao gio commit len Git.
~$*
