# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ===== Bo sung cho UTEExpress (muc 07 buoc 9 trong ke hoach nhom) =====

# Maven build output
target/

# Eclipse
.classpath
.project
.settings/

# IntelliJ IDEA
.idea/
*.iml

# VS Code
.vscode/

# Cau hinh rieng chua mat khau tren tung may va cac ban sao/backup cua chung.
# .gitignore khong bao ve file da tracked; khong dung git add -f cho file bi mat.
# application.properties chi chua placeholder; chi sua gia tri that o file private.
application-local.properties
application-local.properties.*
/config/aiven-local.properties
/config/aiven-local.properties.*
/config/sqlserver-before-aiven.properties
/config/sqlserver-before-aiven.properties.*
/config/certificates/
# Mat khau tam do cong cu khoi phuc tai khoan tao rieng tren may.
/config/recovery/

# Chan file profile cu chua bi mat neu ai copy lai; app khong dung MonsterASP.
application-cloud.properties
application-cloud.properties.*

# Bien moi truong rieng (app khong tu nap .env) va ban sao cua chung.
.env
.env.*
*.env

# Khoa/chung chi/truststore tren may: khong dua len Git hoac chia se cong khai.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Chi cho phep cac file mau khong chua bi mat; KHONG dien gia tri that vao .example.
!application-local.properties.example
!/config/aiven-local.properties.example
!.env.example

# Ban sao du lieu cu (khong duoc ung dung nap).
# Khong day len Git vi chua du lieu that cua nguoi dung (ho ten, so dien thoai,
# dia chi) va file co the rat nang.
db/backup/

# Tep nguoi dung tai len khi chay thu (anh/video danh gia) - khong day len Git
uploads/
uploads-private/

# File khoa tam cua Microsoft Word/Excel (~$ten-file.docx).
# Word tu tao khi mo tai lieu va tu xoa khi dong - khong bao gio commit len Git.
~$*
